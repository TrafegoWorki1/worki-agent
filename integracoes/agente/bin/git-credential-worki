#!/bin/sh
# Ajudante de credencial do git: so responde para github.com, com o token do
# arquivo. Ativado por GIT_CONFIG_* no entrypoint, sem depender do HOME.
CRED="${WORKI_CREDENCIAIS_DIR:-/opt/data/.credenciais}"
[ "${1:-}" = "get" ] || exit 0
host=""
while IFS= read -r linha; do
    [ -z "$linha" ] && break
    case "$linha" in host=*) host="${linha#host=}" ;; esac
done
[ "$host" = "github.com" ] || exit 0
[ -r "$CRED/github_token" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$CRED/github_token")"
