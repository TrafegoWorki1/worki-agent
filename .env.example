# =============================================================
# worki-agent — variaveis de ambiente do SERVICO (EasyPanel)
#
# Este arquivo vai para o GitHub. So nomes e explicacao, sem valor.
# Copie para .env APENAS para desenvolvimento local. No EasyPanel as
# variaveis sao configuradas no painel do servico — nao existe .env no
# container.
#
# O codigo le do AMBIENTE primeiro e do .env depois (util para local).
# =============================================================

# -------------------------------------------------------------
# Evolution API — canal WhatsApp
# -------------------------------------------------------------
# URL base que JA atende a Evolution. NAO e a URL do webhook.
EVOLUTION_API_URL=
# Chave da API (header apikey).
EVOLUTION_API_KEY=
# Nome da instancia. Grafia real do deploy: agent-domintante
# (SEM o "i"). Nao "corrigir" para 'dominante'.
EVOLUTION_INSTANCE=agent-domintante
# Opcional. So se a versao instalada exigir token por instancia
# (header Authorization Bearer).
EVOLUTION_WEBHOOK_TOKEN=

# -------------------------------------------------------------
# Supabase — fila, tarefas, outbox, aprovacoes
# -------------------------------------------------------------
SUPABASE_URL=https://wxqwtyotkkshdjzzwjsk.supabase.co
# SERVICE ROLE: apenas servidor. NUNCA no frontend, NUNCA no bundle
# da pagina, NUNCA com prefixo VITE_ ou NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# So para a CLI (aplicar migracao). Nao va no container do servico.
SUPABASE_ACCESS_TOKEN=

# -------------------------------------------------------------
# WhatsApp — allowlist (AGENTS.md secao 2)
# -------------------------------------------------------------
# SEU WhatsApp: 558592494552. Unico autorizado a dar ordem.
# O 5585999515154 e o TELEGRAM e nao entra aqui: nao passa pelo
# webhook da Evolution.
WHATSAPP_NUMERO_AUTORIZADO=558592494552
# JIDs de grupo autorizados, separados por virgula.
# VAZIA = NENHUM grupo permitido. Negado e o padrao.
# (Plural por padrao. O singular antigo ainda e lido como fallback,
# mas o canonico e este.)
WHATSAPP_GRUPO_COMANDO_JIDS=
# Chip do agente: recebe e responde, NAO comanda.
WHATSAPP_AGENTE_NUMERO=558586661513

# -------------------------------------------------------------
# Servico
# -------------------------------------------------------------
# Porta interna do receptor HTTP.
PORT=8080
# Segredo do receptor. Se VAZIO, o webhook aceita sem conferir.
# Configure: sem isso, quem souber a URL enfileira trabalho.
WORKI_WEBHOOK_SECRET=
# Una tarefa por vez. Acima de 1, a sessao por conversa passa a
# depender da reserva atomica para nao embaralhar.
WORKI_WORKER_CONCURRENCY=1
# Validade da lease. O worker renova a cada ~1/3 desse valor.
WORKI_WORKER_LEASE_S=120
# Intervalo entre passadas do worker (segundos).
WORKI_RECOVERY_POLL_SECONDS=3
# Limite DURO de uma execucao do Hermes (segundos): passou disso, o worker
# corta o processo e o usuario recebe a mensagem generica de falha. Precisa ser
# MAIOR que o limite de esforco do AGENTS.md s.13 (cerca de 15 min), para o
# agente ter tempo de parar sozinho e explicar o bloqueio. Em producao: 1500.
WORKI_TASK_TIMEOUT_SECONDS=1500
# Aviso de andamento. 0 = desligado (padrao). Com N > 0, se o Hermes ainda nao
# respondeu em N segundos, o worker manda "Recebi. Estou trabalhando nisso...".
# Resposta rapida nao gera aviso. Sugestao: 20.
WORKI_ACK_AFTER_SECONDS=0
# Caracteres por mensagem no WhatsApp. Resposta maior e dividida em varias
# mensagens, em limite de paragrafo (nunca no meio de uma frase). 0 = nao dividir.
WORKI_WHATSAPP_MAX_CHARS=1500
# Atalho de andamento: "terminou?", "cade?", "e ai?" sao respondidos na hora
# pelo receptor quando ha um pedido em execucao (o worker processa um por vez,
# entao a pergunta esperaria a tarefa acabar). 0 desliga.
WORKI_ATALHO_ANDAMENTO=1
# Volume de trabalho (checkout, arquivos gerados).
WORKI_WORKSPACE_DIR=/workspace
# Estado do Hermes. Precisa ser volume, senao a sessao se perde.
WORKI_HERMES_HOME=/opt/data
# Fixo so se quiser identificar a worker explicitamente.
# Padrao: hostname-pid.
WORKI_WORKER_ID=
# INFO normal. DEBUG so para diagnostico (fala o texto das mensagens).
LOG_LEVEL=INFO

# -------------------------------------------------------------
# Ferramentas (skill de paginas)
# -------------------------------------------------------------
# Token so dos repositorios do Herickson em TrafegoWorki1.
GITHUB_TOKEN=
# Repo de destino da pagina, escolhido por projeto.
GITHUB_REPO_PAGINA=
VERCEL_TOKEN=
# ID do TIME (comeca com team_), nao o slug. Serve para todos os apps.
# NAO defina VERCEL_PROJECT_ID: cada app e um projeto e e vinculado na pasta
# dele com `vercel link --yes --project <nome-do-app>`.
VERCEL_ORG_ID=

# -------------------------------------------------------------
# Audio e documentos (integracoes/midia.py; AGENTS.md secao 17)
# -------------------------------------------------------------
# Servidor Whisper proprio. Base da URL, sem caminho e sem barra no fim.
# Sem WHISPER_URL o audio recebe um aviso; documento funciona sem ele.
WHISPER_URL=
WHISPER_API_KEY=
# auto = tenta /transcribe, /v1/audio/transcriptions e /asr; ou fixe: transcribe | openai | asr
WORKI_STT_FORMATO=auto
WORKI_STT_MODELO=whisper-1
WORKI_STT_IDIOMA=pt
WORKI_MIDIA_MAX_MB=20
WORKI_ENTRADA_DIR=/workspace/entrada

# -------------------------------------------------------------
# Jev (TypeSafe AI): decisao tipada. Chave paga por chamada; AGENTS.md secao 16.
# -------------------------------------------------------------
TYPESAFE_API_KEY=

# -------------------------------------------------------------
# Zernio: Google Meu Negocio, Instagram e conta de anuncios do Facebook.
# Comeca em leitura — AGENTS.md secoes 3 e 5.
# -------------------------------------------------------------
ZERNIO_API_KEY=
# Servidor MCP (registrar no config do Hermes)
ZERNIO_MCP_URL=

# -------------------------------------------------------------
# Limites — AGENTS.md secao 6
# -------------------------------------------------------------
# Teto diario de gasto em anuncios. O agente NUNCA ultrapassa.
TETO_ORCAMENTO_DIARIO=
# Margem abaixo da media de 7d que dispara alerta de queda de conversao
MARGEM_QUEDA_CONVERSAO=0.15
# Minimo de visitas para considerar a taxa confiavel
VISITAS_MINIMAS_PARA_ALERTA=30
# Grupo para onde o agente envia relatorios
GRUPO_RELATORIO_JID=

# -------------------------------------------------------------
# Pagina de captacao (Vite — precisa do prefixo VITE_)
# -------------------------------------------------------------
# Em Vite, variavel SEM o prefixo VITE_ nao chega ao navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_NOME_PAGINA=worki-performance-hub
