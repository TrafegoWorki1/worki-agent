# =============================================================
# worki-agent — variaveis de ambiente
# COPIE para .env e preencha. NUNCA commite o .env.
# =============================================================
# Este arquivo vai para o GitHub. So nomes e explicacao, sem valor.
# =============================================================

# -------------------------------------------------------------
# Evolution API — canal WhatsApp
# -------------------------------------------------------------
# URL base da sua instancia do Evolution API
EVOLUTION_API_URL=https://SEU-DOMINIO/evolution
# Chave da API (header apikey). No painel: Manager > Chaves
EVOLUTION_API_KEY=
# Nome da instancia do agente
EVOLUTION_INSTANCE=agent-domintante
# Token especifico da instancia (header Authorization Bearer)
EVOLUTION_INSTANCE_TOKEN=

# -------------------------------------------------------------
# WhatsApp — allowlist
# -------------------------------------------------------------
# Numero do HERICKSON. Unico autorizado a dar ordem.
WHATSAPP_NUMERO_AUTORIZADO=
# JID do grupo de comando (formato 5585...@g.us)
WHATSAPP_GRUPO_COMANDO_JID=
# Numero do chip do agente. Recebe e responde, NAO comanda.
WHATSAPP_AGENTE_NUMERO=

# -------------------------------------------------------------
# Supabase — dados do agente
# -------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SERVICE ROLE: apenas servidor. NUNCA no frontend, NUNCA no repo.
SUPABASE_SERVICE_ROLE_KEY=
# ANON: unica chave que pode ir no bundle do frontend.
SUPABASE_ANON_KEY=
# Token pessoal, so para a CLI (criar tabela, migration)
SUPABASE_ACCESS_TOKEN=

# -------------------------------------------------------------
# GitHub — pagina
# -------------------------------------------------------------
# Token com escopo minimo: so o repo da pagina.
# No seu caso a CLI `gh` ja esta autenticada e nao precisa disto.
# So necessario se rodar em CI.
GITHUB_TOKEN=
GITHUB_REPO_PAGINA=TrafegoWorki1/worki-performance-hub

# -------------------------------------------------------------
# Vercel — hosting
# -------------------------------------------------------------
# No seu caso: `vercel login` ja autentica a CLI. Nao precisa de token.
#so use VERCEL_TOKEN se rodar em CI.
VERCEL_TOKEN=
VERCEL_ORG_ID=trafegos-projects

# -------------------------------------------------------------
# Zernio — Meta Ads e Instagram (Fase 5)
# -------------------------------------------------------------
ZERNIO_API_KEY=
# Servidor MCP (registrar no config do Hermes)
ZERNIO_MCP_URL=https://mcp.zernio.com/mcp

# -------------------------------------------------------------
# Limites — AGENTS.md secao 6
# -------------------------------------------------------------
# Teto diario de gasto em anuncios. O agente NUNCA ultrapassa.
TETO_ORCAMENTO_DIARIO=
# Margem abaixo da media de 7d que dispara alerta de queda de conversao
MARGEM_QUEDA_CONVERSAO=0.15
# Minimo de visitas para considerar a taxa confiavel
VISITAS_MINIMAS_PARA_ALERTA=30
# Grupo para onde o agente envia relatorios
GRUPO_RELATORIO_JID=

# -------------------------------------------------------------
# Pagina de captacao (Vite — precisa do prefixo VITE_)
# -------------------------------------------------------------
# Em Vite, variavel SEM o prefixo VITE_ nao chega ao navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_NOME_PAGINA=worki-performance-hub